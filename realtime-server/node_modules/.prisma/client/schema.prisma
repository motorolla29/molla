// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Перечисление для статуса объявления
enum AdStatus {
  active
  archived
}

// Модель продавца
model Seller {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  name       String
  phone      String?
  avatar     String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Связи
  ads          Ad[]
  buyerChats   Chat[]    @relation("BuyerChats")
  sellerChats  Chat[]    @relation("SellerChats")
  sentMessages Message[]

  @@map("sellers")
}

// Модель объявления
model Ad {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float?
  currency    String   @default("RUB")
  category    String
  city        String
  address     String?
  latitude    Float?
  longitude   Float?
  status      AdStatus @default(active)
  photos      String[] // Массив URL фото
  sellerId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  seller      Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  chats       Chat[]
  attachments AdAttachment[]

  @@map("ads")
}

// Модель чата
model Chat {
  id        Int      @id @default(autoincrement())
  buyerId   Int
  sellerId  Int
  adId      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  buyer    Seller    @relation("BuyerChats", fields: [buyerId], references: [id])
  seller   Seller    @relation("SellerChats", fields: [sellerId], references: [id])
  ad       Ad        @relation(fields: [adId], references: [id])
  messages Message[]

  @@unique([buyerId, sellerId, adId])
  @@map("chats")
}

// Модель сообщения
model Message {
  id          Int      @id @default(autoincrement())
  chatId      Int
  senderId    Int
  content     String
  messageType String   @default("text") // text, image
  status      String   @default("sent") // sent, delivered, read
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      Seller              @relation(fields: [senderId], references: [id])
  attachments MessageAttachment[]

  @@map("messages")
}

// Модель вложения объявления
model AdAttachment {
  id       Int    @id @default(autoincrement())
  adId     Int
  fileUrl  String
  fileName String
  fileType String
  fileSize Int?

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@map("ad_attachments")
}

// Модель вложения сообщения
model MessageAttachment {
  id        Int    @id @default(autoincrement())
  messageId Int
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}
